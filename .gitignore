# Track only the website and the rules in this file.
/*
!/.gitignore
!/README.md
!/index.html
!/CNAME
!/robots.txt
!/sitemap.xml
!/css/
!/images/
!/script/

# The browser needs JavaScript modules, not local build/optimization tools.
/script/*
!/script/*.js

# Ignore incidental local files even inside website folders.
__pycache__/
.DS_Store
Thumbs.db
